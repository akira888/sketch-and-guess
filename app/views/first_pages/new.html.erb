<div class="card">
  <p>
    あなたのお題カードはこちら
  </p>
  <%= tag.ul class: "prompts" do %>
    <% @card.prompts.pluck(:word).each do |word| %>
      <%= tag.li word %>
    <% end %>
  <% end %>
  <% if @current_user.can_redraw? %>
    <%= button_to "カードを引き直す(3回まで)", user_path(@current_user), method: :patch %>
  <% end %>
  <button>これでOK</button>
</div>
